// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "sqlite"
}

enum PermissionLevel {
  SYSOP
  ADMIN
  NORMAL
  SEMIBANNED
  BANNED
}

model Permissions {
  id    String          @id
  level PermissionLevel

  @@map("permissions")
}

model Groups {
  id      String  @id
  enabled Boolean @default(false)

  @@map("groups")
}

model FeatureEnables {
  id      Int     @id @default(autoincrement())
  scope   String
  feature String
  enabled Boolean @default(false)

  @@unique([scope, feature])
  @@index([scope])
  @@map("feature_enables")
}

model StartWikis {
  scope String @id
  start String

  @@map("start_wikis")
}

model ScopeInterwiki {
  id     Int    @id @default(autoincrement())
  scope  String
  prefix String
  url    String

  @@unique([scope, prefix])
  @@map("scope_interwikis")
}

model MinecraftServer {
  id                    Int                    @id @default(autoincrement())
  endpoint              String                 @unique
  owner                 String
  /// @Type [StringArray]
  operators             Json                   @default("[]")
  credential            String?
  minecraftServerScopes MinecraftServerScope[]

  @@index([endpoint])
  @@map("minecraft_server")
}

model MinecraftServerScope {
  id       Int             @id @default(autoincrement())
  scope    String
  name     String
  altName  String?         @map("alt_name")
  serverId Int             @map("server_id")
  server   MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([scope, name])
  @@map("minecraft_server_scope")
}
